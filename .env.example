# Concord Live Sponsor Integrations Environment Configuration
# Copy this file to .env in the repository root:
#   cp .env.example .env
#
# Note: .env is git-ignored and will never be committed.

# ==============================================================================
# FRONT A: PHOTON 2.0 (Mobile SMS Operations)
# ==============================================================================
# Your Photon API key for authenticating outbound SMS dispatch:
PHOTON_API_KEY=

# The SMS-capable phone number provisioned by Photon for your Concord agent (E.164 format):
PHOTON_PHONE_NUMBER=

# (Optional) Photon API base URL (defaults to https://api.photon.com/v1):
# PHOTON_API_BASE_URL=https://api.photon.com/v1

# Secret used to verify incoming webhook signatures (X-Photon-Signature):
PHOTON_WEBHOOK_SECRET=

# (Optional) Comma-separated list of authorized coordinator/investigator phone numbers:
# PHOTON_ALLOWED_SENDERS=+16175550199,+16175550100


# ==============================================================================
# FRONT B: CHALK (Agent Evaluation & Benchmarking)
# ==============================================================================
# Your Chalk Client ID and Client Secret from the Chalk web dashboard (chalk.ai):
CHALK_CLIENT_ID=
CHALK_CLIENT_SECRET=

# (Optional) Chalk environment or active token if using chalk login:
# CHALK_API_TOKEN=


# ==============================================================================
# FRONT C: FACTORY DROID SDK (Autonomous Protocol Planning Agent)
# ==============================================================================
# Your Factory API key for @factory/droid-sdk sessions (factory.ai):
FACTORY_API_KEY=
