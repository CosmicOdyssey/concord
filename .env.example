# Optional server-only credentials. Never commit .env or expose values as VITE_*.
# Load explicitly before starting the API; ordinary demo needs none of these.
CONCORD_SPONSOR_OPERATOR_TOKEN=
CONCORD_REVIEW_TOKEN=

# Photon Beta (2.0): exact pre-approved project, agent User and Space.
# Never guess the first space or use a phone number as a User ID.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_AGENT_USER_ID=
PHOTON_SPACE_ID=
# Local Concord normalized webhook contract, NOT verified beta event schema.
PHOTON_WEBHOOK_SECRET=
PHOTON_ALLOWED_SENDERS=
# Explicit operator approval required before enabling real outbound requests.
CONCORD_ALLOW_PHOTON_SEND=0

# Chalk Compute Evaluations: install backend/requirements-sponsors.txt.
# Select an environment with Evaluations, authenticated Function queue and storage.
CHALK_CLIENT_ID=
CHALK_CLIENT_SECRET=
CHALK_ENVIRONMENT_ID=
# Remote run deploys bounded task/scorer Functions and consumes compute.
CONCORD_ALLOW_CHALK_RUN=0

# Factory: npm --prefix frontend ci and official droid CLI on PATH.
FACTORY_DROID_EXEC_PATH=
FACTORY_API_KEY=
# Explicit non-Claude/non-Astra model; automatic routing is disabled.
FACTORY_MODEL_ID=
# One bounded SDK turn, original-engine tools, independent proposal validation.
CONCORD_ALLOW_FACTORY_RUN=0
