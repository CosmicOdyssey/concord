{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:compare": "node --experimental-strip-types --test tests/compare.test.mjs",
    "test:financial": "node --experimental-strip-types --test tests/financial.test.mjs",
    "test:portfolio": "node --experimental-strip-types --test tests/portfolio.test.mjs",
    "test:demo": "node --experimental-strip-types --test tests/demo.test.mjs",
    "test": "npm run test:financial && npm run test:portfolio && npm run test:demo",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
